# ==============================================================================
# DevShelf — Конфигурация для хостинга Beget (Apache 2.4 + Nginx)
# ==============================================================================

# Принудительная кодировка UTF-8
AddDefaultCharset UTF-8

# Запрет листинга каталогов
Options -Indexes

# ------------------------------------------------------------------------------
# Принудительные MIME-типы (критично для Beget + nosniff)
# Без явного указания text/css и text/javascript современные браузеры блокируют
# стили и скрипты из-за заголовка X-Content-Type-Options: nosniff
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  # Стили
  AddType text/css                             .css css
  
  # JavaScript & ES Modules
  AddType text/javascript                      .js js .mjs mjs
  AddType application/javascript               .js js
  
  # Данные и манифесты
  AddType application/json                     .json json
  AddType application/ld+json                  .jsonld jsonld
  AddType application/manifest+json            .webmanifest webmanifest
  AddType application/xml                      .xml xml
  AddType text/xml                             .xml xml
  
  # Графика и шрифты
  AddType image/svg+xml                        .svg svg .svgz svgz
  AddType image/x-icon                         .ico ico
  AddType font/woff                            .woff woff
  AddType font/woff2                           .woff2 woff2
  
  # Бинарные файлы
  AddType application/octet-stream             .exe exe
</IfModule>

# ------------------------------------------------------------------------------
# Заголовки Content-Type и управление кэшированием
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Защита от подмены MIME-типов
  Header set X-Content-Type-Options "nosniff"
  
  # Принудительный Content-Type для CSS для исключения любых накладок Nginx/Apache
  <FilesMatch "\.css$">
    ForceType text/css
    Header set Content-Type "text/css; charset=UTF-8"
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Принудительный Content-Type для JS
  <FilesMatch "\.(js|mjs)$">
    ForceType text/javascript
    Header set Content-Type "text/javascript; charset=UTF-8"
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # JSON-ресурсы и манифест
  <FilesMatch "\.(json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # HTML-страницы не должны залипать в кэше при пушах с GitHub
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# Перенаправления и коррекция URL на Beget
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Добавляем завершающий слэш для каталогов, чтобы относительные пути (./styles.css)
  # разрешались корректно при размещении в подпапках на Beget
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ $1/ [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# Gzip-сжатие
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
