# ==============================================================================
# DevShelf — Конфигурация Apache для хостинга Beget
# ==============================================================================

# Принудительное включение UTF-8
AddDefaultCharset UTF-8

# Запрет просмотра листинга каталогов
Options -Indexes

# ------------------------------------------------------------------------------
# 1. Принудительный 301-редирект с HTTP на HTTPS
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Проверка протокола (для Beget и Nginx reverse proxy)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 2. Правильные MIME-типы для современных веб-стандартов
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/json               json
  AddType application/ld+json            jsonld
  AddType application/xml                xml
  AddType text/xml                       xml
  AddType image/svg+xml                  svg svgz
  AddType font/woff                      woff
  AddType font/woff2                     woff2
</IfModule>

# ------------------------------------------------------------------------------
# 3. Gzip-сжатие текстовых ресурсов
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 4. Базовые заголовки безопасности
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
